#!/usr/bin/env bash
# Serves https://github.com/horopter-dev/horopter/releases/download/<tag>/<asset> from
# $FAKE_RELEASES/<tag>/<asset>, and fails like curl -f on anything it does not hold.
set -euo pipefail
: "${CURL_LOG:?}" "${FAKE_RELEASES:?}"
out="" url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2" && shift ;;
    http*) url="$1" ;;
    *) ;;
  esac
  shift
done
printf '%s\n' "$url" >> "$CURL_LOG"
path="${url#https://github.com/horopter-dev/horopter/releases/download/}"
file="$FAKE_RELEASES/$path"
if [[ "$path" = "$url" || ! -f "$file" ]]; then
  echo "curl: (22) The requested URL returned error: 404" >&2
  exit 22
fi
if [[ -n "$out" ]]; then
  cp "$file" "$out"
else
  cat "$file"
fi
